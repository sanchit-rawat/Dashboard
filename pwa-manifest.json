{
    "manifest_version": 3,
    "name": "Aesthetic Dashboard",
    "description": "A beautiful glassmorphism new tab dashboard with time tracking.",
    "version": "2.0",

    "chrome_url_overrides": {
        "newtab": "index.html"
    },

    "background": {
        "service_worker": "background.js"
    },

    "permissions": [
        "storage",
        "tabs",
        "alarms"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "icons": {
        "16":  "icon-192.png",
        "48":  "icon-192.png",
        "128": "icon-512.png"
    }
}
